From ef8394982189661b9ef9917ac0923ca6a77f91f9 Mon Sep 17 00:00:00 2001
From: Xianglong Kong <xkong@anaconda.com>
Date: Mon, 1 Jun 2026 12:00:00 -0500
Subject: [PATCH] relocate converter imports under llama_cpp_tools

The recipe installs upstream's conversion/ package as llama_cpp_tools.conversion and examples/convert_legacy_llama.py as llama_cpp_tools.convert_legacy_llama, so every import of them must be redirected: the module-level import in convert_hf_to_gguf.py, its function-level imports for Mistral-format (including Mistral Large 4), DeepSeek-V4 and DeepSeek-V4.1 models, ModelBase.load_hparams_guess() in conversion/base.py, the dynamic model-module imports in conversion/__init__.py (made package-relative via __name__), and the --model-metadata-dir path of convert_llama_ggml_to_gguf.py. load_hparams_guess() and the dynamic imports run for every HF-format model.
---
 conversion/__init__.py        |  6 +++---
 conversion/base.py            |  2 +-
 convert_hf_to_gguf.py         | 16 ++++++++--------
 convert_llama_ggml_to_gguf.py |  2 +-
 4 files changed, 13 insertions(+), 13 deletions(-)

diff --git a/conversion/__init__.py b/conversion/__init__.py
index 1370dd3..2ca475f 100644
--- a/conversion/__init__.py
+++ b/conversion/__init__.py
@@ -436,7 +436,7 @@ def load_all_models() -> None:
         for module_name in _TEXT_MODEL_MODULES:
             if module_name not in _loaded_text_modules:
                 try:
-                    __import__(f"conversion.{module_name}")
+                    __import__(f"{__name__}.{module_name}")
                     _loaded_text_modules.add(module_name)
                 except Exception as e:
                     logger.warning(f"Failed to load model module {module_name}: {e}")
@@ -445,7 +445,7 @@ def load_all_models() -> None:
         for module_name in _MMPROJ_MODEL_MODULES:
             if module_name not in _loaded_mmproj_modules:
                 try:
-                    __import__(f"conversion.{module_name}")
+                    __import__(f"{__name__}.{module_name}")
                     _loaded_mmproj_modules.add(module_name)
                 except Exception as e:
                     logger.warning(f"Failed to load model module {module_name}: {e}")
@@ -457,7 +457,7 @@ def get_model_class(name: str, mmproj: bool = False) -> Type[ModelBase]:
     if name not in relevant_map:
         raise NotImplementedError(f"Architecture {name!r} not supported!")
     module_name = relevant_map[name]
-    __import__(f"conversion.{module_name}")
+    __import__(f"{__name__}.{module_name}")
     model_type = ModelType.MMPROJ if mmproj else ModelType.TEXT
     return ModelBase._model_classes[model_type][name]
 
diff --git a/conversion/base.py b/conversion/base.py
index 28f2bf2..17fcf97 100644
--- a/conversion/base.py
+++ b/conversion/base.py
@@ -1652,7 +1652,7 @@ class ModelBase:
     @staticmethod
     def load_hparams_guess(dir_model: Path) -> dict[str, Any] | None:
         # some models ship no config.json, will try to guess them
-        from conversion import load_all_models
+        from llama_cpp_tools.conversion import load_all_models
         load_all_models()
 
         for matcher, loader in ModelBase._hparams_loaders:
diff --git a/convert_hf_to_gguf.py b/convert_hf_to_gguf.py
index b863bcc..d9e5f8d 100755
--- a/convert_hf_to_gguf.py
+++ b/convert_hf_to_gguf.py
@@ -15,7 +15,7 @@ if 'NO_LOCAL_GGUF' not in os.environ:
     sys.path.insert(1, str(Path(__file__).parent / 'gguf-py'))
 import gguf
 
-from conversion import (
+from llama_cpp_tools.conversion import (
     ModelBase,
     ModelType,
     get_model_architecture,
@@ -253,16 +253,16 @@ def main() -> None:
                 sys.exit(1)
         elif args.mmproj:
             assert hparams.get("vision_encoder") is not None, "This model does not support multimodal"
-            from conversion.pixtral import PixtralModel
+            from llama_cpp_tools.conversion.pixtral import PixtralModel
             model_class = PixtralModel
         elif hparams.get("moe") is not None and hparams.get("dsa") is not None:
-            from conversion.mistral4 import MistralLarge4Model
+            from llama_cpp_tools.conversion.mistral4 import MistralLarge4Model
             model_class = MistralLarge4Model
         elif hparams.get("moe") is not None:
-            from conversion.mistral import MistralMoeModel
+            from llama_cpp_tools.conversion.mistral import MistralMoeModel
             model_class = MistralMoeModel
         else:
-            from conversion.mistral import MistralModel
+            from llama_cpp_tools.conversion.mistral import MistralModel
             model_class = MistralModel
 
         if sum((args.mtp, args.no_mtp, args.dspark)) > 1:
@@ -274,16 +274,16 @@ def main() -> None:
                 if model_class.__name__ != "MistralLarge4Model":
                     logger.error("--dspark is only supported for Mistral Large 4 among Mistral-format models")
                     sys.exit(1)
-                from conversion.mistral4 import MistralLarge4DSparkModel
+                from llama_cpp_tools.conversion.mistral4 import MistralLarge4DSparkModel
                 model_class = MistralLarge4DSparkModel
             elif model_architecture not in ("DeepseekV4ForCausalLM", "DeepseekV41ForCausalLM"):
                 logger.error("--dspark is only supported for DeepseekV4ForCausalLM, DeepseekV41ForCausalLM and Mistral Large 4")
                 sys.exit(1)
             elif model_architecture == "DeepseekV41ForCausalLM":
-                from conversion.deepseek41 import DeepseekV41DSparkModel
+                from llama_cpp_tools.conversion.deepseek41 import DeepseekV41DSparkModel
                 model_class = DeepseekV41DSparkModel
             else:
-                from conversion.deepseek import DeepseekV4DSparkModel
+                from llama_cpp_tools.conversion.deepseek import DeepseekV4DSparkModel
                 model_class = DeepseekV4DSparkModel
 
         if args.mtp or args.no_mtp:
diff --git a/convert_llama_ggml_to_gguf.py b/convert_llama_ggml_to_gguf.py
index 52827e6..3c264b1 100755
--- a/convert_llama_ggml_to_gguf.py
+++ b/convert_llama_ggml_to_gguf.py
@@ -358,7 +358,7 @@ class GGMLToGGUF:
 
 
 def handle_metadata(cfg, hp):
-    import examples.convert_legacy_llama as convert
+    import llama_cpp_tools.convert_legacy_llama as convert
 
     assert cfg.model_metadata_dir.is_dir(), 'Metadata dir is not a directory'
     hf_config_path   = cfg.model_metadata_dir / "config.json"
