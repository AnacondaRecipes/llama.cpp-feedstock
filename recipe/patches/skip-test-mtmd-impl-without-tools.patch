From e101f9fa26cae1ddad5dcf2691cb2c8af0b34cff Mon Sep 17 00:00:00 2001
From: Xianglong Kong <xkong@anaconda.com>
Date: Mon, 5 Oct 2026 15:12:02 -0500
Subject: [PATCH] Skip test-mtmd-impl when the mtmd target is not built

test-mtmd-impl links the mtmd library, which only exists when tools are built; the libllama build disables tools, so guard the test with if (TARGET mtmd).
---
 tests/CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index a0488f2..648e363 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -339,7 +339,9 @@ endif()
 # libmtmd
 llama_build_and_test(test-mtmd-c-api.c LINK mtmd)
 
-llama_build_and_test(test-mtmd-impl.cpp LINK mtmd)
+if (TARGET mtmd)
+    llama_build_and_test(test-mtmd-impl.cpp LINK mtmd)
+endif()
 
 # GGUF model data fetcher library for tests that need real model metadata
 # Only compile when cpp-httplib has SSL support (CPPHTTPLIB_OPENSSL_SUPPORT)
