From bc4b3a27343ebaabfaab1ec164eb27feafd419e9 Mon Sep 17 00:00:00 2001
From: xkong-anaconda <xkong@anaconda.com>
Date: Sat, 17 Oct 2026 22:09:23 -0500
Subject: [PATCH] tests: link test-backend-ops with Threads::Threads

AI assistant generated patch.

test-backend-ops now links only ggml, so it no longer gets Threads::Threads
from llama-common (PUBLIC). ggml-base links Threads PRIVATE, so on glibc
< 2.34, where pthread is still in libpthread, the std::thread use fails to
link: undefined reference to pthread_create / pthread_join.
---
 tests/CMakeLists.txt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 648e363..7bea346 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -316,6 +316,9 @@ if (GGML_METAL AND NOT GGML_BACKEND_DL)
 endif()
 
 llama_build(test-backend-ops.cpp LINK ggml)
+# std::thread needs Threads::Threads, which llama-common used to provide (libpthread on glibc < 2.34)
+find_package(Threads REQUIRED)
+target_link_libraries(test-backend-ops PRIVATE Threads::Threads)
 
 llama_build_and_test(test-tiled-mulmat.cpp LINK ggml)
 llama_build_and_test(test-model-load-cancel.cpp LABEL "model")
