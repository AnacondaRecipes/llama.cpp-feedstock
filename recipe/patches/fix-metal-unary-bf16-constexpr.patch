From c9daee149d606adc30b4c5b7a3254697c9771e2b Mon Sep 17 00:00:00 2001
From: Georgi Gerganov <ggerganov@gmail.com>
Date: Thu, 29 Oct 2026 10:09:51 +0200
Subject: [PATCH] ggml-metal : fix unary kernels compile on older Metal
 toolchains (#31360)

Assisted-by: dsh:llama.cpp/ggml-org/Qwen3.8-Flash-Next-GGUF (MacBook, M5 Max, 128GB)

Anaconda: backport of ggml-org/llama.cpp#31360, merged after v0.8.0. Without it,
Macs whose Metal compiler rejects the constexpr bfloat4 casts (upstream issues
#31272 and #31337: macOS 14 and 15) fail to build the Metal unary library, so
every context creation fails. Reproduced with the CI osx-arm64 mps package on
macOS 15.7.3 / Apple M4 Pro; the CI Mac (macOS 13) has BF16 off and never
compiles this code.
---
 ggml/src/ggml-metal/kernels/unary.metal | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-metal/kernels/unary.metal b/ggml/src/ggml-metal/kernels/unary.metal
index 8c2c18ebd6b3..9d24f028c399 100644
--- a/ggml/src/ggml-metal/kernels/unary.metal
+++ b/ggml/src/ggml-metal/kernels/unary.metal
@@ -11,12 +11,12 @@ inline constexpr T ggml_metal_unary_cast(U x) {
 #if defined(GGML_METAL_HAS_BF16)
 // MSL has no C-style cast from float vectors to bfloat vectors
 template <>
-inline constexpr bfloat4 ggml_metal_unary_cast<bfloat4, float4>(float4 x) {
+inline bfloat4 ggml_metal_unary_cast<bfloat4, float4>(float4 x) {
     return bfloat4(bfloat(x[0]), bfloat(x[1]), bfloat(x[2]), bfloat(x[3]));
 }
 
 template <>
-inline constexpr bfloat4 ggml_metal_unary_cast<bfloat4, float>(float x) {
+inline bfloat4 ggml_metal_unary_cast<bfloat4, float>(float x) {
     return bfloat4(bfloat(x), bfloat(x), bfloat(x), bfloat(x));
 }
 #endif
